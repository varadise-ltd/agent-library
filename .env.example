PORT=4000
HOST=127.0.0.1
VARADISE_DEV_WATCH=false
DATA_DIR=./data
PROJECT_SOURCE_ROOTS=./project-sources
RUNTIME_DIR=./runtime-data
# PostgreSQL is the production data backend. The legacy JSON adapter remains available only for isolated tests and rollback.
DATA_BACKEND=postgres
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql://varadise:replace-with-a-long-database-password@127.0.0.1:6543/varadise
DATABASE_SCHEMA=varadise
# disable for the local Docker service; use require or verify-full for a managed TLS database.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
# First port in the per-project Hermes bridge range; each paired project gets its own port.
HERMES_WHATSAPP_MANAGED_PORT=3001
# Internal second Hermes process for agent-middleware mode. It stays inside the existing agent-platform container.
HERMES_AGENT_MIDDLEWARE_PORT=3010
# Maximum JSON request size accepted by the middleware (includes base64 image attachments).
HERMES_AGENT_MIDDLEWARE_MAX_REQUEST_BYTES=67108864
# Optional external Hermes provider. Leave blank when using the NousResearch
# CLI installed inside the existing agent-platform container.
HERMES_AGENT_MIDDLEWARE_UPSTREAM=
# Authentication used only when runtime kind is external.
HERMES_AGENT_MIDDLEWARE_UPSTREAM_SECRET=
HERMES_AGENT_MIDDLEWARE_SECRET=
# NousResearch Hermes CLI is installed and executed inside the existing
# agent-platform container. It receives one authorized request per process.
HERMES_AGENT_CLI=hermes
HERMES_AGENT_VENDOR=nousresearch
HERMES_AGENT_CLI_PROVIDER=custom
HERMES_AGENT_MIDDLEWARE_RUNTIME_KIND=local-cli
# JSON array of CLI arguments. The current NousResearch one-shot command uses
# --cli -z PROMPT and avoids launching the interactive TUI.
HERMES_AGENT_CLI_ARGS_JSON=["--cli","-z","{prompt}"]
HERMES_AGENT_CLI_INPUT_MODE=argument
# Optional comma-separated provider variables inherited by the CLI. Platform
# database, encryption and administrator secrets are never inherited.
HERMES_AGENT_PASSTHROUGH_ENV=
APP_SECRET=replace-with-a-long-random-value
VARADISE_ADMIN_EMAIL=admin@varadise.com
VARADISE_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional Unicode font override for generated PDFs. Windows auto-detects Noto Sans TC/HK when installed.
# VARADISE_PDF_FONT=C:\Windows\Fonts\NotoSansTC-VF.ttf
# VARADISE_PDF_FONT_FAMILY=
